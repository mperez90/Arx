# /etc/arx-collector.env — mode 0600, owner root. Never commit the real file.
ARX_COLLECTOR_INTERVAL_DAYS=7
ARX_COLLECTOR_MAIL_TO=reports@example.com
ARX_COLLECTOR_MAIL_FROM=arx-collector@example.com
ARX_COLLECTOR_SMTP_HOST=smtp.example.com
ARX_COLLECTOR_SMTP_PORT=587
ARX_COLLECTOR_SMTP_TLS=starttls
ARX_COLLECTOR_SMTP_USER=arx-collector@example.com
ARX_COLLECTOR_SMTP_PASSWORD=change-me
