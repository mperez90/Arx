# /volume2/docker/services/arx-collector/.env — mode 0600. Never commit the real file.
ARX_COLLECTOR_INTERVAL_DAYS=7
ARX_COLLECTOR_MAIL_TO=reports@example.com
ARX_COLLECTOR_MAIL_FROM=Arx <telemetry@example.com>
# Resend over SMTP: user "resend", password = a Resend API key with sending access.
ARX_COLLECTOR_SMTP_HOST=smtp.resend.com
ARX_COLLECTOR_SMTP_PORT=465
ARX_COLLECTOR_SMTP_TLS=ssl
ARX_COLLECTOR_SMTP_USER=resend
ARX_COLLECTOR_SMTP_PASSWORD=re_change_me
